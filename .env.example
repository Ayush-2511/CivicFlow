# CivicFlow Environment Configuration

# LLM Provider Configuration
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_STRONG=openai/gpt-oss-120b

# Gemini Configuration (Fallback)
GEMINI_API_KEY=your_gemini_api_key_here
MODEL_FAST=gemini-3-flash-preview
MODEL_STRONG=gemini-3-flash-preview
LLM_TIMEOUT_SECONDS=30

# Application Settings
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Language & Localization
SUPPORTED_LANGUAGES=["hi", "en", "mr", "ta", "te", "bn"]
DEFAULT_LANGUAGE=hi

# Storage & Cache
SQLITE_DB_PATH=civicflow_checkpoints.sqlite
AUDIO_OUTPUT_DIR=audio_cache
UPLOAD_DIR=uploads

